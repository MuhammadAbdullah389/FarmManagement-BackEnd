<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Insert New Record</title>
    <link rel="stylesheet" href="/styles/home.css">
</head>
<body>
    <header>
        <h2>Welcome <%= username %>!</h2>
        <h4><%= date %></h4>
    </header>

    <nav>
        <ul>
            <% if (role === "admin") { %>
                <li><a href="/">Dashboard</a></li>
                <li><a href="/update">Update a Record</a></li>
            <% } %>
            <li><a href="/view">View Records</a></li>
            <li><a href="/contact">Contact the Developer</a></li>
            <li><a href="/getmonths">Get Reports</a></li>
        </ul>
    </nav>

    <section class="page-card page-card-form">
        <form action="/update/new/check-date" method="POST">
            <h3>Select Date For New Record</h3>
            <label for="date">Enter Date:</label>
            <input type="date" id="date" name="date" value="<%= selectedDateInput %>" min="<%= minDate %>" max="<%= maxDate %>" required>
            <% if (error) { %>
                <p><%= error %></p>
            <% } %>
            <button type="submit">Continue</button>
        </form>
    </section>

    <% if (showForm) { %>
        <h3 class="sub-heading">Adding New Record for <%= selectedDate %></h3>
        <form id="mainForm" action="/submit" method="POST">
            <input type="hidden" name="recordDate" value="<%= selectedDate %>">
            <h3>Milk Quantity</h3>
            <div>
                <label for="morningMilk">Enter the morning Milk quantity:</label>
                <input type="number" id="morningMilk" name="morningMilk" required step="0.01">
                <br><br>
                <label for="eveningMilk">Enter the evening Milk quantity:</label>
                <input type="number" id="eveningMilk" name="eveningMilk" required step="0.01">
                <br><br>
            </div>

            <div id="expenseContainer" style="display:none;">
                <h3>Expenses</h3>
                <div id="expenseForm"></div>
            </div>

            <div id="revenueContainer" style="display:none;">
                <h3>Revenues</h3>
                <div id="revenueForm"></div>
            </div>

            <button type="button" id="addExpenseButton">Add Expense</button>
            <button type="button" id="addRevenueButton">Add Revenue</button>
            <button type="submit">Submit</button>
        </form>
    <% } %>

    <% if (showForm) { %>
        <script src="/scripts/home.js"></script>
    <% } %>
</body>
</html>
