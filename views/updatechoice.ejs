<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Update Options</title>
    <link rel="stylesheet" href="/styles/dateSelect.css">
</head>
<body>
    <header>
        <h2>Welcome <%= username %>!</h2>
        <h4><%= date %></h4>
    </header>

    <nav>
        <ul>
            <% if (role === "admin") { %>
                <li><a href="/">Dashboard</a></li>
                <li><a href="/update">Update a Record</a></li>
            <% } %>
            <li><a href="/view">View Records</a></li>
            <li><a href="/contact">Contact the Developer</a></li>
            <li><a href="/getmonths">Get Reports</a></li>
        </ul>
    </nav>

    <section class="page-card">
        <h2>What do you want to do?</h2>

        <div class="action-buttons">
            <button type="button" onclick="location.href='/update/existing'">Change Existing Record</button>
            <button type="button" onclick="location.href='/update/new'">Insert New Record</button>
        </div>
    </section>
</body>
</html>
